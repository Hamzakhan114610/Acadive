# ==============================================================================
# ACADIV MONGODB & BACKEND CONFIGURATION
# Instructions for Team Member:
# 1. Replace the MONGODB_URI below with your real MongoDB Atlas or Local connection string.
# 2. Example Atlas URI: mongodb+srv://username:password@cluster0.xyz.mongodb.net/acadiv?retryWrites=true&w=majority
# ==============================================================================

# MongoDB Connection String (PASTE YOUR KEY HERE)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/acadiv?retryWrites=true&w=majority

# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=acadiv_super_secure_jwt_secret_key_2026
JWT_REFRESH_SECRET=acadiv_super_secure_refresh_secret_key_2026
JWT_EXPIRES_IN=7d
